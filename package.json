{
  "name": "obsidian-kanban",
  "version": "2.0.51",
  "description": "This is a sample plugin for Obsidian (https://obsidian.md)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check-all": "yarn check:types && yarn check:code && yarn check:format",
    "check:types": "tsc --noEmit",
    "check:code": "eslint src",
    "check:submission": "eslint src --config eslint.submission.config.mjs",
    "check:format": "prettier --check \"./src/**/*.{ts,tsx}\"",
    "fix": "yarn fix:format && yarn fix:code",
    "fix:format": "prettier --write \"./src/**/*.{ts,tsx}\"",
    "fix:code": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "rlnotes": "git log $(git describe --tags --abbrev=0)..HEAD --oneline > release-notes.md && git add release-notes.md",
    "bump": "node version-bump.mjs && git add package.json manifest.json versions.json && yarn rlnotes",
    "release": "git commit -m $npm_package_version && git tag $npm_package_version && git push && git push --tags"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@eslint/js": "^9.39.5",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/box-intersect": "^1.0.0",
    "@types/mark.js": "^8.11.5",
    "@types/node": "^14.14.37",
    "@types/raf-schd": "^4.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.11",
    "esbuild-plugin-less": "^1.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.6",
    "magic-string": "^0.30.10",
    "obsidian": "^1.13.1",
    "obsidian-dataview": "^0.5.66",
    "obsidian-plugin-cli": "^0.9.0",
    "prettier": "^3.1.1",
    "replace": "^1.2.2",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tanstack/match-sorter-utils": "^8.15.1",
    "@tanstack/react-table": "^8.11.2",
    "animated-scroll-to": "^2.2.0",
    "box-intersect": "^1.0.2",
    "choices.js": "9.0.1",
    "classcat": "^5.0.3",
    "colord": "^2.9.3",
    "deepmerge": "^4.2.2",
    "eventemitter3": "^5.0.1",
    "fast-json-patch": "^3.1.0",
    "file-selector": "^0.2.4",
    "immutability-helper": "^3.1.1",
    "immutable-json-patch": "^1.1.2",
    "is-plain-object": "^5.0.0",
    "mark.js": "^8.11.1",
    "mdast": "^3.0.0",
    "mdast-util-from-markdown": "^1.0.2",
    "mdast-util-frontmatter": "^1.0.0",
    "mdast-util-to-markdown": "^1.2.6",
    "mdast-util-to-string": "^3.1.0",
    "micromark-extension-frontmatter": "^1.1.1",
    "micromark-factory-space": "^1.1.0",
    "micromark-util-character": "^1.1.0",
    "micromark-util-symbol": "^1.1.0",
    "micromark-util-types": "^1.0.1",
    "moment": "2.29.4",
    "monkey-around": "^2.1.0",
    "obsidian-daily-notes-interface": "^0.9.4",
    "preact": "^10.8.2",
    "react": "npm:@preact/compat",
    "react-colorful": "^5.6.1",
    "react-cool-onclickoutside": "^1.6.1",
    "react-dom": "npm:@preact/compat",
    "react-fast-compare": "^3.2.2",
    "rrule": "^2.8.1",
    "unist-util-visit": "^4.1.0"
  },
  "resolutions": {
    "eslint": "^9.39.5"
  },
  "importSort": {
    ".js, .ts, .tsx": {
      "style": "module-alias",
      "options": {
        "alias": [
          "src"
        ]
      }
    }
  }
}
